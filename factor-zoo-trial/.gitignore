# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Data: raw and derived files are rebuilt from the sources. Only the SHA-256 manifest is
# committed, so the provenance check can run without the downloads.
data/*
!data/manifest.json
mirror/

# Build products
paper/_output/*
!paper/_output/paper/
paper/_output/paper/*
!paper/_output/paper/paper.pdf
paper/paper.typ
paper/paper_files/
.quarto/

# Notebooks keep code, not outputs
notebooks/.ipynb_checkpoints/

/.quarto/
**/*.quarto_ipynb
